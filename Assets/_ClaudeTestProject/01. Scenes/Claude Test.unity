--- !u!114 &1223403789
MonoBehaviour:
  m_ObjectHideFlags: 0
  m_CorrespondingSourceObject: {fileID: 0}
  m_PrefabInstance: {fileID: 0}
  m_PrefabAsset: {fileID: 0}
  m_GameObject: {fileID: 1223403787}
  m_Enabled: 1
  m_EditorHideFlags: 0
  m_Script: {fileID: 11500000, guid: fec1351d31c0344d188c6bb3f3413871, type: 3}
  m_Name: 
  m_EditorClassIdentifier: Assembly-CSharp::HappyBalloon.HB_Interactable
  prompt: "\uBA54\uBAA8 \uC77D\uAE30"
  eventId: memo
  oneShot: 1
  interactable: 1
  hideOnUse: 0
  useSound: page
  noteTitle: "\uAD00\uB9AC \uCC45\uC784\uC790 \uBA54\uBAA8 (\uD3D0\uC7A5\uC77C)"
  noteBody: "<b>\uC808\uB300\uB85C \uBA54\uC778 \uC804\uC6D0\uC744 \uB2E4\uC2DC \uC62C\uB9AC\uC9C0
    \uB9D0 \uAC83.</b>\n\n\uC804\uAE30\uAC00 \uB4E4\uC5B4\uC624\uBA74 \uBC84\uBE14
    \uB3D9\uC0C1 \uC548\uC758 \uC1A1\uD48D\uAE30\uAC00 \uB2E4\uC2DC \uB3CC\uC544\uAC04\uB2E4.\n\uADF8
    \uB140\uC11D\uC740 \uBC14\uB78C\uC744 \uBA39\uACE0 <b>\uC0B4\uC544 \uC6C0\uC9C1\uC778\uB2E4</b>.\n\n\uC544\uC774\uB4E4\uC740
    \uC228\uBC14\uAF2D\uC9C8\uC744 \uD558\uB294 \uC904 \uC54C\uC558\uB2E4.\n\uC881\uC740
    \uBB38\uD2C8\uC5D0 \uBAB8\uC774 \uB07C\uBA74 \uD55C\uB3D9\uC548 \uAF3C\uC9DD
    \uBABB \uD55C\uB2E4\uB294 \uAC83\uB3C4, \uC544\uC774\uB4E4\uC774 \uBA3C\uC800
    \uC54C\uC544\uB0C8\uB2E4.\n\n\uD55C\uACBD\uC218 \uC528\uAC00 \uBC24\uB9C8\uB2E4
    \uC804\uC6D0\uC744 \uC62C\uB9AC\uB824\uACE0 \uD55C\uB2E4.\n\uADF8 \uC0AC\uB78C\uC744
    \uB4E4\uC5EC\uBCF4\uB0B4\uC9C0 \uB9C8."
  noteImage: {fileID: 0}
