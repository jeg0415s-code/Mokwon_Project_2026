  m_Name: 
  m_EditorClassIdentifier: Assembly-CSharp::HappyBalloon.HB_Interactable
  prompt: "\uC9C1\uC6D0 \uACF5\uC9C0 \uC77D\uAE30"
  eventId: notice
  oneShot: 1
  interactable: 1
  hideOnUse: 0
  useSound: page
  noteTitle: "\uC9C1\uC6D0 \uACF5\uC9C0 (1999.08)"
  noteBody: "1. \uD38C\uD504 \uAC74\uC740 \uB9E4\uD45C\uC18C \uB4A4 \uC120\uBC18\uC5D0
    \uBCF4\uAD00\uD560 \uAC83.\n2. 2\uCE35 \uAD00\uB9AC\uC2E4 \uACC4\uB2E8 \uBCF4\uC218
    \uACF5\uC0AC \uC911. \uCD9C\uC785\uC740 <b>\uACC4\uB2E8 \uC606 \uD48D\uC120 \uBC1C\uD310</b>\uC744
    \uC774\uC6A9\uD560 \uAC83.\n   (\uBC1C\uD310 \uC704\uC5D0 \uC62C\uB77C\uC11C\uC11C
    \uBC1C\uD310\uC744 \uD5A5\uD574 <b>\uD38C\uD504 \uAC74\uC73C\uB85C \uACF5\uAE30
    \uC8FC\uC785</b>)\n3. \uBBF8\uB85C \uB180\uC774\uBC29\uC758 \uD48D\uC120 \uBB38\uC740
    \uBC14\uB78C\uC744 \uBE7C\uBA74 \uC5F4\uB9BC.\n4. \uD3D0\uC7A5 \uD6C4 <b>\uBC84\uBE14
    \uB3D9\uC0C1 \uADFC\uCC98\uC5D0 \uC544\uC774\uB97C \uD63C\uC790 \uB450\uC9C0
    \uB9D0 \uAC83.</b>"
  noteImage: {fileID: 0}
