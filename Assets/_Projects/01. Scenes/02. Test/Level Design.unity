--- !u!114 &1274586545
MonoBehaviour:
  m_ObjectHideFlags: 0
  m_CorrespondingSourceObject: {fileID: 0}
  m_PrefabInstance: {fileID: 0}
  m_PrefabAsset: {fileID: 0}
  m_GameObject: {fileID: 1274586543}
  m_Enabled: 1
  m_EditorHideFlags: 0
  m_Script: {fileID: 11500000, guid: fec1351d31c0344d188c6bb3f3413871, type: 3}
  m_Name: 
  m_EditorClassIdentifier: Assembly-CSharp::HappyBalloon.HB_Interactable
  prompt: "\uC791\uC5C5 \uC77C\uC9C0 \uC77D\uAE30"
  eventId: worklog
  oneShot: 1
  interactable: 1
  hideOnUse: 0
  useSound: page
  noteTitle: "\uD0DC\uC5FD \uC778\uD615 \uC2DC\uD5D8 \uC77C\uC9C0"
  noteBody: "\uC2DC\uD5D8 7\uD68C\uCC28.\n\uD0DC\uC5FD \uC778\uD615\uC774 <b>\uC881\uC740
    \uBB38\uD2C0</b>\uC744 \uC9C0\uB098\uAC08 \uB54C \uD38C\uD504\uB85C \uACF5\uAE30\uB97C
    \uC8FC\uC785\uD558\uBA74\n\uBAB8\uC774 \uBD80\uD480\uC5B4 \uBB38\uD2C0\uC5D0
    <b>\uAF49 \uB07C\uC5B4</b> \uBE60\uC838\uB098\uC624\uC9C0 \uBABB\uD55C\uB2E4.\n\n\u203B
    \uBB38\uD2C0 <b>\uBC16</b>\uC5D0\uC11C \uBD80\uD480\uB9AC\uBA74 \uC18C\uC6A9\uC5C6\uC74C.
    \uBC18\uB4DC\uC2DC <b>\uBB38\uD2C0 \uC548</b>\uC5D0\uC11C.\n\n\uBC84\uBE14\uC5D0\uAC8C\uB3C4
    \uAC19\uC740 \uBC29\uBC95\uC774 \uD1B5\uD560 \uAC83\uC73C\uB85C \uBCF4\uC784.\n\uB2E4\uB9CC
    \uBC84\uBE14\uC740 \uD798\uC774 \uC138\uC11C <b>\uBA87 \uCD08</b> \uB4A4\uBA74
    \uBE60\uC838\uB098\uC628\uB2E4."
  noteImage: {fileID: 0}
